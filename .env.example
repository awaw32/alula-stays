# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth (دومين الإنتاج — للتطوير المحلي استخدم http://localhost:5173)
CONVEX_SITE_URL=https://soqaqalaula.world

# الرابط العام للموقع (يُستخدم في روابط التحقق من البريد والمدفوعات)
SITE_URL=https://soqaqalaula.world

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ====== FTP (النشر على Namecheap) ======
# انسخها إلى ملف .env.ftp (غير مرفوع لـ git) ويقرأها scripts/deploy-ftp.mjs
FTP_HOST=your-server.com
FTP_USER=user@domain.com
FTP_PASS=********
FTP_PORT=21
